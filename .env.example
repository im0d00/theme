# Environment Variables for Lizzdo WordPress Theme

# Gemini AI API Key (optional, for AI-powered features)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# WordPress REST API URL (leave empty to auto-detect from window.wpData)
# VITE_WP_API_URL=https://your-wordpress-site.com/wp-json

# WordPress Site URL
# VITE_WP_SITE_URL=https://your-wordpress-site.com
